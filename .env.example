# API Keys
PIONEER_API_KEY=your_pioneer_api_key_here
QDRANT_API_KEY=
QDRANT_URL=http://localhost:6333

# Application
APP_NAME=AutoLinks
DEBUG=false
DRY_RUN=false

# GLiNER
